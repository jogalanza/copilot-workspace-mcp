# Copy to .env (git-ignored). Loaded automatically by `npm run dev` / `npm start`.

# Required: shared secret. Clients send it as header `api-key: <key>`,
# `Authorization: Bearer <key>`, or query `?api_key=<key>`.
# Generate one with:  npm run new-key
MCP_API_KEY=

# Port (8787 is used by another local project).
PORT=8790

# Workspaces registered at startup: alias=path, separated by ';'
WORKSPACES=mcp=D:/Red Files/Projects/copilot-mcp

# Default for chats that have not chosen a workspace (optional; else the first WORKSPACES entry).
DEFAULT_WORKSPACE=mcp

# add_workspace may only register folders under these roots (';'-separated). Empty = disabled.
ALLOWED_ROOTS=D:/Red Files/Projects;D:/Repos

# Optional
# STATE_DB=%LOCALAPPDATA%/copilot-mcp/state.db
# BINDING_TTL_DAYS=30
# MAX_WRITE_BYTES=1048576
# MAX_READ_BYTES=1048576
# MAX_LIST_RESULTS=500
# ENABLE_STDIO=false
# MCP_ALLOW_ANONYMOUS=false   # local testing only
