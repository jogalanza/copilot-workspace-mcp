# Copy to .env (git-ignored). Loaded automatically by `npm run dev` / `npm start`.

# Required: shared secret. Clients send it as header `api-key: <key>`,
# `Authorization: Bearer <key>`, or query `?api_key=<key>`.
# Generate one with:  npm run new-key
MCP_API_KEY=

# Port (8787 is used by another local project).
PORT=8790

# Paths may contain spaces. Wrap whole values in double quotes: an unquoted '#'
# (e.g. "C# Projects") starts a comment and silently truncates the path.
# Per-entry quotes (demo="D:/My Projects/x") and file:/// URLs are also accepted.

# Workspaces registered at startup: alias=path, separated by ';'
WORKSPACES="demo=D:/My Projects/demo"

# Default for chats that have not chosen a workspace (optional; else the first WORKSPACES entry).
DEFAULT_WORKSPACE=demo

# add_workspace may only register folders under these roots (';'-separated). Empty = disabled.
ALLOWED_ROOTS="D:/My Projects;D:/Repos"

# Optional
# STATE_DB=%LOCALAPPDATA%/copilot-mcp/state.db
# BINDING_TTL_DAYS=30
# MAX_WRITE_BYTES=1048576
# MAX_READ_BYTES=1048576
# MAX_LIST_RESULTS=500
# ENABLE_STDIO=false
# MCP_ALLOW_ANONYMOUS=false   # local testing only

# --- Headless browser tools (browser_open / browser_screenshot / browser_text / browser_click / browser_type /
# --- browser_logs / browser_eval / browser_close). Off by default. Drives an installed Edge/Chrome; nothing is downloaded.
# ENABLE_BROWSER=true               # the standalone launcher turns this on by default (set false to disable)
# BROWSER_CHANNEL=msedge            # or chrome
# BROWSER_EXECUTABLE=               # full path to a Chromium-based browser (overrides BROWSER_CHANNEL)
# Hosts the browser may load (';'-separated, "*.example.com" allowed). Default is localhost only, which
# stops the agent from using this machine as a proxy into your network.
# BROWSER_ALLOWED_HOSTS=localhost;127.0.0.1;[::1]
# BROWSER_IDLE_MINUTES=10

# --- run_command / process_output / process_stop / list_processes. Off unless this list is non-empty.
# Each entry is a command prefix; extra plain arguments are allowed, shell operators/quotes never are.
# Do NOT list interpreters (node, python, powershell, cmd): their arguments can run arbitrary code.
# ENABLE_GIT=false                  # git_* tools are on by default; set false to disable
# RUN_ALLOWED_COMMANDS="npm run dev;npm run build;npm test"
# RUN_TIMEOUT_SECONDS=120
# MAX_BACKGROUND_PROCESSES=3
# MAX_PROCESS_OUTPUT_BYTES=65536

# --- Standalone launcher only
# Tunnel accepts unauthenticated clients (default true; the API key still protects /mcp).
# Copilot Studio / M365 Copilot need this. false = only your own Microsoft account can connect.
# TUNNEL_ALLOW_ANONYMOUS=true
