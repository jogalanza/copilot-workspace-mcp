{
  "name": "copilot-workspace-mcp",
  "version": "1.4.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "new-key": "node scripts/new-api-key.mjs",
    "audit": "npm audit --omit=dev",
    "build:shell": "node scripts/build-shell.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:standalone:linux": "node scripts/build-standalone.mjs linux",
    "build:standalone:mac": "node scripts/build-standalone.mjs mac",
    "build:standalone:all": "node scripts/build-standalone.mjs all",
    "package": "node scripts/build-standalone.mjs all && node scripts/package-release.mjs",
    "package:current": "node scripts/build-standalone.mjs && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "fast-glob": "3.3.3",
    "playwright-core": "1.63.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
